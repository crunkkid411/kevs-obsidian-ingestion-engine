# ============================================
# Source: pick one (dropbox or google-drive)
# ============================================
SOURCE=dropbox

# Dropbox
DROPBOX_ACCESS_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_FOLDER=

# Google Drive (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_DRIVE_FOLDER_ID=

# ============================================
# AI: Claude (default) or Gemini
# ============================================
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Optional: Gemini (only if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# ============================================
# Whisper transcription
# ============================================
# WHISPER_MODE: local (free, on-device) or api (paid OpenAI)
WHISPER_MODE=local
# Model size: tiny, base, small, medium, large
WHISPER_MODEL=base
# Only needed if WHISPER_MODE=api
OPENAI_API_KEY=

# ============================================
# Database (Postgres / insforge / Supabase / any Postgres)
# ============================================
DATABASE_URL=

# ============================================
# Obsidian vault
# ============================================
OBSIDIAN_VAULT_PATH=./vault
OBSIDIAN_NOTES_FOLDER=Videos

# ============================================
# Processing config
# ============================================
# Cron schedule for the watcher (default: every 15 minutes)
CRON_SCHEDULE=*/15 * * * *

# Temp download directory
TEMP_DIR=./tmp/downloads

# Max file size in bytes (default 2 GB)
MAX_FILE_SIZE_BYTES=2147483648
