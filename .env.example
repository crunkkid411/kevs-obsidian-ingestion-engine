# ════════════════════════════════════════════════════════════════════════
# FORENSIC VIDEO INGESTION — environment
# Copy to .env and fill in. See docs/SETUP-WINDOWS.md + docs/MODELS-2026.md.
# ════════════════════════════════════════════════════════════════════════

# ── Source (evidence-safe local drive recommended) ──────────────────────
SOURCE=local
# Folder or drive to scan recursively. Files are READ-ONLY, never modified/deleted.
LOCAL_ROOT=D:\footage

# ── Database (Postgres + pgvector REQUIRED for search) ──────────────────
# Local: install Postgres + `CREATE EXTENSION vector;`  Or use Supabase/Neon.
DATABASE_URL=

# ── Taxonomy ────────────────────────────────────────────────────────────
# Defaults to config/taxonomy.investigation.example.json until you create
# config/taxonomy.json. Or point directly:
# TAXONOMY_PATH=config/taxonomy.json

# ── ASR (transcription) ─────────────────────────────────────────────────
ASR_BACKEND=parakeet                       # parakeet | whisper | none
ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3

# ── Speaker diarization (audio) ─────────────────────────────────────────
DIAR_BACKEND=sortformer                     # sortformer | none
DIAR_MODEL=nvidia/diar_streaming_sortformer_4spk-v2.1
DIAR_MAX_SPEAKERS=4

# ── Visual active-speaker detection (the misattribution fix) ────────────
ASD_BACKEND=lr-asd                          # lr-asd | none  (stub until wired)
ASD_CONF_FLOOR=0.6

# ── Video understanding (used ONLY on flagged/queried segments) ─────────
VIDEO_BACKEND=qwen3-vl-local                 # qwen3-vl-local | openrouter | gemini | none
VIDEO_MODEL=Qwen/Qwen3-VL-8B-Instruct-GGUF
VIDEO_API_MODEL=qwen/qwen3-vl-8b-instruct

# ── Embeddings (semantic search) ────────────────────────────────────────
TEXT_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
TEXT_EMBED_DIM=1024                          # MUST match schema vector(N)
MM_EMBED_ENABLED=false
MM_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B

# ── API keys (optional — for the expensive triage tier) ─────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Pipeline tuning ─────────────────────────────────────────────────────
SCENE_THRESHOLD=0.4
KEYFRAMES_PER_SHOT=1
UNDERSTAND_FLAGGED_ONLY=true
PYTHON_BIN=python
TEMP_DIR=./tmp/work

# ── Obsidian (optional human-review surface) ────────────────────────────
OBSIDIAN_VAULT_PATH=./vault
OBSIDIAN_NOTES_FOLDER=Cases

# ── Legacy Dropbox source (only if SOURCE=dropbox) ──────────────────────
DROPBOX_ACCESS_TOKEN=
DROPBOX_FOLDER=
